{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "strictPropertyInitialization": true,
    "noFallthroughCasesInSwitch": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "incremental": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "composite": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@/satellites/*": ["satellites/*"],
      "@/core/*": ["core/*"],
      "@/shared/*": ["shared/*"],
      "@/types/*": ["types/*"],
      "@/utils/*": ["utils/*"],
      "@/config/*": ["config/*"],
      "@/compliance/*": ["compliance/*"],
      "@/integrations/*": ["integrations/*"],
      "@/api/*": ["api/*"],
      "@/auth/*": ["auth/*"],
      "@/docs/*": ["docs/*"],
      "@/security/*": ["security/*"],
      "@/testing/*": ["testing/*"],
      "@/websocket/*": ["websocket/*"]
    }
  },
  "include": [
    "src/api/**/*",
    "src/shared/logging/**/*",
    "src/shared/utils/**/*",
    "src/shared/database/manager-simple.ts",
    "src/types/**/*",
    "src/index.ts"
  ],
  "files": [
    "src/core/orchestration/state/pkg/state.d.ts",
    "src/types/qdrant.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "docs",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**/*",
    "src/core/communication/satellite-message-bus.ts",
    "src/core/communication/protocol.ts",
    "src/core/communication/message-validator.ts",
    "src/core/orchestration/engine.ts",
    "src/core/messaging/bus.ts",
    "src/core/security/security-framework.ts",
    "src/core/communication/satellite-routing-engine.ts",
    "src/core/communication/secure-satellite-protocol.ts",
    "src/core/orchestration/satellite-factory.ts",
    "src/core/security/authentication-manager.ts",
    "src/core/security/encryption-manager.ts",
    "src/core/communication/satellite-network-manager.ts",
    "src/integrations/**/*"
  ],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}